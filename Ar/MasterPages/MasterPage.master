    <style>
       /* --- 1. الحاوية الرئيسية والخلفية --- */
#loader-wrapper {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(180deg, #fceabb 0%, #fccd4d 40%, #ffffff 100%);
    z-index: 99999999999999999;
    display: flex;
    justify-content: center;
    align-items: center;
    overflow: hidden;
    transition: opacity 0.6s ease, transform 0.6s ease;
    margin: 0;
    padding: 0;
    pointer-events: all;
}

.preloader-logo {
    width: 120px;
    animation: logo-pulse 1.2s ease-in-out infinite;
    position: relative;
    transition: transform 0.8s ease;
}

@keyframes logo-pulse {
    0% { transform: scale(1); }
    50% { transform: scale(1.1); }
    100% { transform: scale(1); }
}

.preloader-logo.shine {
    transform: scale(1.15);
    animation: none;
}

/* Using pseudo element on a wrapper or using css filter since img doesn't have ::after well */
.preloader-logo-container {
    position: relative;
    display: inline-block;
}

.preloader-logo.shine {
    filter: brightness(1.3) drop-shadow(0 0 10px rgba(255,255,255,0.8));
}

.preloader-exit {
    opacity: 0;
    transform: scale(1.1);
}
   </style>
    <style>
        /* زر العودة للأعلى - منضبط حسب منطق الرؤية */
        .back-to-top {
            position: fixed;
            bottom: 25px;
            display: none;
            background-color: #ffc107;
            color: #fff !important;
            width: 50px;
            height: 50px;
            border-radius: 50%;
            border: none;
            cursor: pointer;
            z-index: 100;
            box-shadow: 0 4px 15px rgba(0,0,0,0.3);
            transition: all 0.3s ease;
            font-size: 20px;
            line-height: 50px;
            text-align: center;
        }

        /* التحكم في الاتجاه بناءً على خاصية dir في الـ html */
        /* لو الصفحة عربي (RTL) خليه يمين */
        [dir="rtl"] .back-to-top {
            right: 25px;
            left: auto;
        }

        /* لو الصفحة إنجليزي (LTR) خليه شمال */
        [dir="ltr"] .back-to-top {
            left: 25px;
            right: auto;
        }

        .back-to-top:hover {
            background-color: #e0a800;
            transform: translateY(-5px);
        }

        :root {
            --safe-area-inset-top: env(safe-area-inset-top, 0px);
            --safe-area-inset-bottom: env(safe-area-inset-bottom, 0px);
            --safe-area-inset-left: env(safe-area-inset-left, 0px);
            --safe-area-inset-right: env(safe-area-inset-right, 0px);
        }

        body {
            padding-bottom: var(--safe-area-inset-bottom);
        }

        .header {
            padding-top: calc(8px + var(--safe-area-inset-top));
        }
        /* WhatsApp Floating Button */
.whatsapp-float {
    position: fixed;
    bottom: 90px; /* مرتفع قليلاً عن زر العودة للأعلى */
    width: 55px;
    height: 55px;
    background-color: #25d366;
    color: #FFF !important;
    border-radius: 50px;
    text-align: center;
    font-size: 30px;
    box-shadow: 2px 2px 10px rgba(0,0,0,0.2);
    z-index: 90;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
}

/* ضبط الاتجاه حسب اللغة */
[dir="rtl"] .whatsapp-float {
    right: 25px;
}

[dir="ltr"] .whatsapp-float {
    left: 25px;
}

.whatsapp-float:hover {
    transform: scale(1.1);
    background-color: #128c7e;
}

/* تأثير النبض الاختياري */
.whatsapp-float::before {
    content: "";
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: #25d366;
    border-radius: 50%;
    z-index: -1;
    animation: pulse-whatsapp 2s infinite;
}

@keyframes pulse-whatsapp {
    0% { transform: scale(1); opacity: 0.5; }
    100% { transform: scale(1.6); opacity: 0; }
}
    </style>
