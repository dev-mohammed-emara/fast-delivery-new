<body>
    <form id="form1" runat="server">
        <asp:Literal ID="ltscript" runat="server"></asp:Literal> 
    <script>
  
    function showModal() {
        
          var isAuthenticated = <%=HttpContext.Current.User.Identity.IsAuthenticated.ToString().ToLower() %>;
        if(isAuthenticated){
            const userDropDown = document.getElementById("userDropDown");
            const currentDisplay = userDropDown.style.display;
            if (currentDisplay === 'flex') {
                // hide it
                userDropDown.style.setProperty('display', 'none', 'important');
                userDropDown.style.setProperty('opacity', '0', 'important');
                userDropDown.style.setProperty('pointer-events', 'none', 'important');
                userDropDown.style.setProperty('visibility', 'hidden', 'important');
            } else {
                // show it
                userDropDown.style.setProperty('display', 'flex', 'important');
                userDropDown.style.setProperty('opacity', '1', 'important');
                userDropDown.style.setProperty('pointer-events', 'auto', 'important');
                userDropDown.style.setProperty('visibility', 'visible', 'important');
                userDropDown.style.setProperty('transform', 'scale(1)', 'important');
            }
        }
        else{
            
            document.getElementById('popupFrame').src = 'login.aspx';
            var modal = new bootstrap.Modal(document.getElementById('pageModal'));
            modal.show();
        }
  }
</script>
