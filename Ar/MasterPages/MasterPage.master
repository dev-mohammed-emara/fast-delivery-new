    <script>
        function handleProfileClick(event) {
            if (event) event.preventDefault();

            // Check if user is logged in via the body class
            const isLoggedOut = document.body.classList.contains('not-logged-in');

            if (isLoggedOut) {
                showModal();
            } else {
                // Determine if we should show desktop or mobile menu
                if (window.innerWidth <= 768) {
                    if (typeof toggleMobileProfileMenu === 'function') {
                        toggleMobileProfileMenu(event);
                    }
                } else {
                    if (typeof toggleProfileMenu === 'function') {
                        toggleProfileMenu(event);
                    }
                }
            }
        }
    </script>
      <link rel="stylesheet" href="css/main.css">
   <%-- <link href="css/css_web.css" rel="stylesheet" />--%>
   <script type="text/javascript">
       const btnUp = document.getElementById("backToTop");
       window.onscroll = function() {
           if (document.body.scrollTop > 300 || document.documentElement.scrollTop > 300) {
               btnUp.style.display = "block";
           } else {
               btnUp.style.display = "none";
           }
       };
        btnUp.onclick = function() {
            window.scrollTo({ top: 0, behavior: 'smooth' });
        };
         function setLang(lang) {
             var expireDate = new Date();
             expireDate.setFullYear(expireDate.getFullYear() + 1); // الكوكي لمدة سنة
             document.cookie = "lang=" + lang + "; expires=" + expireDate.toUTCString() + "; path=/";
             location.reload();
         }

         window.shareShopGlobal = function(e) {
             if (e) e.preventDefault();
             const texts = window.texts || {};
             const shopNameEl = document.getElementById('shopName') || document.querySelector('.availableShopName');
             const shopName = shopNameEl ? shopNameEl.innerText : 'Fast Delivery';
             const shopUrl = window.location.href;
             const template = texts.ShareMessage || "Order now from {0} via Fast Delivery! {1}";
             const text = template.replace('{0}', shopName).replace('{1}', shopUrl);

             if (navigator.share) {
                 navigator.share({
                     title: texts.ShareTitle || 'Fast Delivery',
                     text: text,
                     url: shopUrl,
                 }).catch(console.error);
             } else {
                 const modalHtml = `
                     <div class="share-modal" style="padding: 1rem; text-align: center;">
                         <h3 style="margin-bottom: 1.5rem;">${texts.ShareTitle || 'مشاركة المتجر'}</h3>
                         <div style="display: flex; justify-content: center; gap: 1.5rem; font-size: 2rem;">
                             <a href="https://wa.me/?text=${encodeURIComponent(text)}" target="_blank" style="color: #25D366;"><i class="fa-brands fa-whatsapp"></i></a>
                             <a href="https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(shopUrl)}" target="_blank" style="color: #1877F2;"><i class="fa-brands fa-facebook"></i></a>
                             <a href="https://twitter.com/intent/tweet?text=${encodeURIComponent(text)}" target="_blank" style="color: #1DA1F2;"><i class="fa-brands fa-twitter"></i></a>
                         </div>
                         <div style="margin-top: 1.5rem;">
                             <input type="text" value="${shopUrl}" id="shareUrlInputGlobal" readonly style="width: 100%; padding: 10px; border: 1px solid #eee; border-radius: 10px; text-align: center; margin-bottom: 10px;">
                             <button onclick="copyToClipboardGlobal('${shopUrl}')" style="background: #ffc107; color: white; border: none; padding: 10px 20px; border-radius: 10px; cursor: pointer; width: 100%; font-weight: 700;">Copy Link</button>
                         </div>
                     </div>
                 `;
                 Swal.fire({
                     html: modalHtml,
                     showConfirmButton: false,
                     width: '320px',
                     padding: '10px'
                 });
             }
         };

         window.copyToClipboardGlobal = function(url) {
             navigator.clipboard.writeText(url).then(() => {
                 Swal.fire({ icon: 'success', title: 'Copied!', timer: 1500, showConfirmButton: false });
             });
         };
    </script>


<script>
document.addEventListener("DOMContentLoaded", function() {
    if (document.querySelector(".newsSwiper")) {
        const newsSwiper = new Swiper(".newsSwiper", {
            slidesPerView: 1.2,
            spaceBetween: 20,
            centeredSlides: true,
            loop: false,

            breakpoints: {
                  1024: {
                    slidesPerView: 3,
                    centeredSlides: false,
                },
                768: {
                    slidesPerView: 2,
                    centeredSlides: false,
                },
            },
        });
    }
});
</script>





     <script>

function getCookie(name) {
    const value = `; ${document.cookie}`;
    const parts = value.split(`; ${name}=`);
    if (parts.length === 2) return parts.pop().split(';').shift();
    return null;
}

function loadTextsOnStart() {
    const lang = getCookie("lang") || "en";

    // امسح أي سكريبت موجود
    const old = document.getElementById("dynamic-texts");
    if (old) old.remove();

    const script = document.createElement("script");
    script.id = "dynamic-texts";
    script.charset = "utf-8";

    // منع الكاش عشان المتصفح مش يشغّل نسخة قديمة
    const rnd = Math.random();
    script.src = `js/texts_${lang}.js?v=${rnd}`;

    // تحميل إجباري
    script.async = false;
    script.defer = false;

    script.onload = function () {
        console.log("Loaded:", script.src);
        try {
            updateUIWithTexts();
        } catch (e) {
            console.warn("updateUIWithTexts missing");
        }
    };

    script.onerror = () => console.error("Error loading language file!");

    document.head.appendChild(script);
}

// تشغيل أول ما الصفحة تحمل
document.addEventListener("DOMContentLoaded", loadTextsOnStart);
</script>
    <script type="text/javascript">
    var isInternalRouting = document.referrer.indexOf(window.location.host) !== -1;
    var isReload = false;


    document.getElementById('searchIconNav').addEventListener('click', function() {
        const shopSearcher = document.getElementById('selectedShopSearcher');
        if (shopSearcher) {
            shopSearcher.focus();
            shopSearcher.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
    });

    window.openSideCart = function() {
        const overlay = document.getElementById('sideCartOverlay');
        if (overlay) {
            overlay.classList.add('openSideCart');
            document.body.style.overflow = 'hidden';
            if (typeof updateCartUI === 'function') {
                updateCartUI();
            }
        }
    };

    window.closeSideCart = function() {
        const overlay = document.getElementById('sideCartOverlay');
        if (overlay) {
            overlay.classList.remove('openSideCart');
            document.body.style.overflow = '';
        }
    };

    // --- Centralized Product Modal Logic ---
    window.currentCustomization = { baseItemId: null, size: null, extras: [], upsells: [], quantity: 1, notes: '' };
    window.currentTriggeringProduct = null;
    window.currentEditItem = null;
    window.basePrice = 0;
    window.addonsPrice = 0;
    window.quantity = 1;
    window.currentProductBasePrice = 0;

    const modalTranslations = {
        ar: { loading: "جاري التحميل...", errorTitle: "خطأ!", connectionError: "حدث خطأ أثناء الاتصال بالسيرفر", errorMessage: "عذراً، لم نتمكن من جلب البيانات", add: "إضافة للسلة", update: "تحديث السلة", selectSize: "اختار الحجم", required: "إجباري", optional: "اختياري", notes: "ملاحظات", notesPlaceholder: "أضف ملاحظاتك هنا...", upsellTitle: "غالباً ما يُطلب مع", save: "حفظ" },
        en: { loading: "Loading...", errorTitle: "Error!", connectionError: "Connection error with the server", errorMessage: "Sorry, we couldn't fetch the data", add: "Add to Cart", update: "Update Cart", selectSize: "Select Size", required: "Required", optional: "Optional", notes: "Notes", notesPlaceholder: "Add your notes here...", upsellTitle: "Often ordered with", save: "Save" }
    };

    window.openProductModal = function(triggerEl, arg2 = null, arg3 = null) {
        let editItem = arg2;
        let focusNotes = !!arg3;

        let id = (typeof triggerEl === 'object' && triggerEl !== null) ? triggerEl.getAttribute('id') : triggerEl;
        // Fallback: if not on PlaceShop page (no #shopId element), get shopId from editItem
        const shopId = String(document.getElementById('shopId')?.innerText.trim() || editItem?.shopId || '');

        if (!editItem && window.cart) {
            // Try to find the item in the cart by base ID or full ID
            editItem = window.cart.items.find(i => (String(i.id) === String(id) || String(i.id).startsWith(id + '-size-')) && String(i.shopId) === String(shopId));
        }

        if (!id && editItem) id = String(editItem.id).split('-size-')[0];

        currentTriggeringProduct = (typeof triggerEl === 'object') ? triggerEl : null;
        currentEditItem = editItem;

        const lang = (typeof getCookie === 'function' ? getCookie("lang") : "ar") || "ar";
        const t = modalTranslations[lang] || modalTranslations.ar;

        Swal.fire({
            title: t.loading,
            allowOutsideClick: false,
            didOpen: () => { Swal.showLoading(); },
            customClass: { container: lang === 'ar' ? 'swal2-rtl' : '' }
        });

        $.ajax({
            type: "POST",
            url: "/Ar/PlaceShop.aspx/GetProductDetails",
            data: JSON.stringify({ itemId: parseInt(id) }),
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (res) {
                if (res.d && res.d.success) {
                    renderProductModal(res.d, editItem, focusNotes);
                } else {
                    Swal.fire({ icon: 'error', title: t.errorTitle, text: res.d?.message || t.errorMessage });
                }
            },
            error: function() {
                Swal.fire({ icon: 'error', title: t.errorTitle, text: t.connectionError });
            }
        });
    };

    window.renderProductModal = function(data, editItem = null, focusNotes = false) {
        const lang = (typeof getCookie === 'function' ? getCookie("lang") : "ar") || "ar";
        const t = modalTranslations[lang] || modalTranslations.ar;

        let savedSize = null;
        if (editItem) {
            const editSizeId = editItem.customization?.size?.id || editItem.sizeId || (typeof editItem.customization?.size === 'string' || typeof editItem.customization?.size === 'number' ? editItem.customization.size : null);
            if (editSizeId && data.sizes) {
                const found = data.sizes.find(s => String(s.id) === String(editSizeId));
                if (found) {
                    savedSize = { id: found.id, name: found.name, price: found.price };
                }
            }
            if (!savedSize && editItem.customization?.size && typeof editItem.customization.size === 'object') {
                savedSize = { ...editItem.customization.size };
            }
        }

        // Sanitize extras/upsells from editItem: force into clean arrays of plain objects
        // This prevents indexed-object corruption from stale localStorage data
        const sanitizeAddonArray = (source) => {
            if (!source) return [];
            // Handle case where source is an object with numeric keys instead of an array
            const arr = Array.isArray(source) ? source : Object.values(source);
            return arr.filter(item => item && typeof item === 'object' && item.id).map(item => ({
                id: String(item.id),
                name: String(item.name || ''),
                price: Number(item.price) || 0,
                qty: Math.max(1, parseInt(item.qty) || 1)
            }));
        };

        currentCustomization = {
            baseItemId: data.id,
            isCustomProduct: !!((data.sizes && data.sizes.length > 0) || (data.extras && data.extras.length > 0) || (data.upsellItems && data.upsellItems.length > 0) || editItem?.isCustomProduct),
            selectedSizeId: savedSize?.id || null,
            size: savedSize ? { id: String(savedSize.id), name: String(savedSize.name || ''), price: Number(savedSize.price) || 0 } : null,
            extras: sanitizeAddonArray(editItem?.customization?.extras),
            upsells: sanitizeAddonArray(editItem?.customization?.upsells),
            quantity: editItem?.amount || 1,
            notes: String(editItem?.customization?.notes || editItem?.notes || '')
        };

        quantity = currentCustomization.quantity;
        currentProductBasePrice = data.price;
        basePrice = currentCustomization.size ? (currentCustomization.size.price || data.price) : data.price;
        recalculateAddonsPrice();

        let sizesHtml = '';
        if (data.sizes && data.sizes.length > 0) {
            data.sizes.forEach(size => {
                const savedSizeId = currentCustomization.size?.id || currentCustomization.size;
                const activeClass = (savedSizeId && String(savedSizeId) === String(size.id)) ? 'active' : '';
                sizesHtml += `
                <div class="option-row ${activeClass}" onclick="selectModalOption(this, ${size.price}, '${size.id}')">
                    <span>${size.name}</span>
                    <div class="price-radio">
                        <span>${size.price} ج.م</span>
                        <div class="radio-circle"></div>
                    </div>
                </div>`;
            });
        }

        let extrasHtml = '';
        if (data.extras && data.extras.length > 0) {
            data.extras.forEach(ex => {
                const existingExtra = currentCustomization.extras.find(e => String(e.id) === String(ex.id));
                const isAdded = !!existingExtra;
                const qty = existingExtra ? (existingExtra.qty || 1) : 1;
                const activeClass = isAdded ? 'active' : '';

                extrasHtml += `
                <div class="option-row extra-item ${activeClass}" data-extra-id="${ex.id}" data-price="${ex.price}" onclick="toggleExtra(this, ${ex.price}, '${ex.id}', '${ex.name}')">
                    <div class="extra-main-info">
                        <div class="extra-badge" style="display: ${isAdded ? 'flex' : 'none'};">${qty}</div>
                        <span>${ex.name}</span>
                        <span class="extra-unit-price">+ ${ex.price} ج.م</span>
                    </div>
                    <div class="extra-actions">
                        <div class="qty-control extra-qty-control" style="display: ${isAdded ? 'flex' : 'none'};" onclick="event.stopPropagation()">
                            <button onclick="updateExtraQty(event, -1, ${ex.price}, '${ex.id}')"><i class="fa-solid fa-minus"></i></button>
                            <span class="extra-qty-val">${qty}</span>
                            <button onclick="updateExtraQty(event, 1, ${ex.price}, '${ex.id}')"><i class="fa-solid fa-plus"></i></button>
                        </div>
                        <div class="price-radio">
                            <div class="radio-circle"></div>
                        </div>
                    </div>
                </div>`;
            });
        }

        let upsellHtml = '';
        if (data.upsellItems && data.upsellItems.length > 0) {
            let upsellSlides = '';
            data.upsellItems.forEach(item => {
                const existingUpsell = currentCustomization.upsells.find(u => String(u.id || u) === String(item.id));
                const isAdded = !!existingUpsell;
                const qty = existingUpsell ? existingUpsell.qty : 1;
                const photo = item.photoUrl || 'images/placeholderImage.webp';

                upsellSlides += `
                <div class="swiper-slide upsell-card-new">
                    <div class="upsell-img-wrapper">
                        <div class="upsell-badge" style="display: ${isAdded ? 'flex' : 'none'};">${qty}</div>
                        <img src="${photo}" onerror="this.src='images/placeholderImage.webp'">
                        <div class="upsell-add-btn" style="display: ${isAdded ? 'none' : 'flex'};" onclick="addUpsellItem(this, ${item.price}, '${item.id}', '${item.name}')">
                            <i class="fa-solid fa-plus"></i>
                        </div>
                        <div class="qty-control" style="display: ${isAdded ? 'flex' : 'none'};" onclick="event.stopPropagation()">
                            <button onclick="updateUpsellQty(this, -1, ${item.price}, '${item.id}')"><i class="fa-solid fa-minus"></i></button>
                            <span class="upsell-qty-val">${qty}</span>
                            <button onclick="updateUpsellQty(this, 1, ${item.price}, '${item.id}')"><i class="fa-solid fa-plus"></i></button>
                        </div>
                    </div>
                    <div class="upsell-info">
                        <h5>${item.name}</h5>
                        <p>EGP ${item.price.toFixed(2)}</p>
                    </div>
                </div>`;
            });
            upsellHtml = `<div class="modal-section upsell-section"><div class="section-header"><h3>${t.upsellTitle}</h3></div><div class="swiper related-products-swiper"><div class="swiper-wrapper">${upsellSlides}</div></div></div>`;
        }

        const modalHtml = `
        <div class="full-modal-container">
            <div class="modal-banner">
                <img src="${data.photoUrl}" onerror="this.src='images/placeholderImage.webp'">
                <button class="modal-close-btn" onclick="Swal.close()"><i class="fa-solid fa-xmark"></i></button>
            </div>
            <div class="modal-content-body">
                <div class="modal-main-info">
                    <h1>${data.name}</h1>
                    <p class="modal-desc">${data.description || ''}</p>
                </div>
                ${sizesHtml ? `<div class="modal-section"><div class="section-header"><h3>${t.selectSize}</h3><span class="required-badge">${t.required}</span></div><div class="options-list">${sizesHtml}</div></div>` : ''}
                ${extrasHtml ? `<div class="modal-section extras-section"><div class="section-header"><h3>الإضافات</h3><span class="optional-badge">${t.optional}</span></div><div class="options-list">${extrasHtml}</div></div>` : ''}
                ${upsellHtml}
                <div class="modal-section"><div class="section-header"><h3>${t.notes}</h3><span class="optional-badge">${t.optional}</span></div><textarea id="product-notes" placeholder="${t.notesPlaceholder}">${currentCustomization.notes}</textarea></div>
            </div>
            <div class="modal-footer-sticky">
                <div class="qty-control">
                    <button onclick="updateModalQty(-1)"><i class="fa-solid fa-minus"></i></button>
                    <span id="modal-qty">${quantity}</span>
                    <button onclick="updateModalQty(1)"><i class="fa-solid fa-plus"></i></button>
                </div>
                <button class="add-to-cart-big" onclick="submitModalCart(${data.id})">
                    <span>${editItem ? t.update : t.add}</span>
                    <strong id="modal-total-price">...</strong>
                </button>
            </div>
        </div>`;

        Swal.fire({
            html: modalHtml,
            showConfirmButton: false,
            width: '500px',
            padding: '0',
            customClass: { container: 'p-0', popup: 'product-modal-popup' },
            didOpen: () => {
                if (data.upsellItems?.length > 0 && typeof Swiper !== 'undefined') {
                    new Swiper('.related-products-swiper', { slidesPerView: 'auto', spaceBetween: 10, freeMode: true });
                }
                if (focusNotes) {
                    const notesArea = document.querySelector('.swal2-container #product-notes');
                    if (notesArea) setTimeout(() => { notesArea.focus(); notesArea.scrollIntoView({ behavior: 'smooth', block: 'center' }); }, 500);
                }
                updateModalTotal();
            }
        });
    };

    window.selectModalOption = function(el, totalSizePrice, sizeId) {
        el.parentElement.querySelectorAll('.option-row').forEach(r => r.classList.remove('active'));
        el.classList.add('active');
        currentCustomization.size = { id: String(sizeId), name: String(el.querySelector('span').innerText || ''), price: Number(totalSizePrice) || 0 };
        basePrice = totalSizePrice;
        updateModalTotal();
    };

    window.toggleExtra = function(el, price, id, name) {
        el.classList.toggle('active');
        const isAdded = el.classList.contains('active');
        const strId = String(id);

        if (isAdded) {
            // Add if not already there — enforce clean object schema
            if (!currentCustomization.extras.some(x => String(x.id) === strId)) {
                currentCustomization.extras = [...currentCustomization.extras, { id: strId, name: String(name), price: Number(price) || 0, qty: 1 }];
            }
        } else {
            // Remove — create a fresh filtered array
            currentCustomization.extras = currentCustomization.extras.filter(x => String(x.id) !== strId);
        }

        // UI feedback for badge and controls — query within the row element directly
        const badge = el.querySelector('.extra-badge');
        const controls = el.querySelector('.extra-qty-control');
        if (badge) {
            badge.style.display = isAdded ? 'flex' : 'none';
            badge.innerText = '1';
        }
        if (controls) {
            controls.style.removeProperty('display');
            controls.style.display = isAdded ? 'flex' : 'none';
            const qtyVal = controls.querySelector('.extra-qty-val');
            if (qtyVal) qtyVal.innerText = '1';
        }

        recalculateAddonsPrice();
        updateModalTotal();
    };

    window.updateExtraQty = function(event, delta, price, id) {
        if (event) {
            event.preventDefault();
            event.stopPropagation();
        }

        const extra = currentCustomization.extras.find(x => String(x.id) === String(id));
        if (!extra) return;

        extra.qty = (extra.qty || 1) + delta;

        if (extra.qty < 1) {
            // Remove the extra if qty becomes 0
            currentCustomization.extras = currentCustomization.extras.filter(x => String(x.id) !== String(id));
            const row = document.querySelector(`.swal2-container .extra-item[data-extra-id="${id}"]`) || document.querySelector(`.extra-item[data-extra-id="${id}"]`);
            if (row) {
                row.classList.remove('active');
                const badge = row.querySelector('.extra-badge');
                if (badge) badge.style.display = 'none';
                const controls = row.querySelector('.extra-qty-control');
                if (controls) controls.style.display = 'none';
            }
        } else {
            // Update display
            const row = document.querySelector(`.swal2-container .extra-item[data-extra-id="${id}"]`) || document.querySelector(`.extra-item[data-extra-id="${id}"]`);
            if (row) {
                const badge = row.querySelector('.extra-badge');
                if (badge) {
                    badge.innerText = extra.qty;
                    badge.style.display = 'flex';
                }
                const qtyVal = row.querySelector('.extra-qty-val');
                if (qtyVal) qtyVal.innerText = extra.qty;
            }
        }

        recalculateAddonsPrice();
        updateModalTotal();
    };

    window.recalculateAddonsPrice = function() {
        let total = 0;
        if (currentCustomization.extras) {
            currentCustomization.extras.forEach(x => total += (x.price || 0) * (x.qty || 1));
        }
        if (currentCustomization.upsells) {
            currentCustomization.upsells.forEach(x => total += (x.price || 0) * (x.qty || 1));
        }
        addonsPrice = total;
    };

    window.updateModalQty = function(delta) {
        quantity = Math.max(1, quantity + delta);
        const qtyEl = document.querySelector('.swal2-container #modal-qty');
        if (qtyEl) qtyEl.innerText = quantity;
        updateModalTotal();
    };

    window.updateModalTotal = function() {
        const el = document.querySelector('.swal2-container #modal-total-price');
        if (!el) return;
        const hasSizes = !!document.querySelector('.swal2-container .option-row:not(.extra-item)');
        if (hasSizes && !currentCustomization.size) {
            el.innerHTML = "اختار الحجم";
            const btn = document.querySelector('.swal2-container .add-to-cart-big');
            if (btn) btn.style.opacity = '0.5';
            return;
        }
        const btn = document.querySelector('.swal2-container .add-to-cart-big');
        if (btn) btn.style.opacity = '1';
        const total = (basePrice * quantity) + addonsPrice;
        el.innerHTML = total.toFixed(2) + ' ج.م';
    };

    window.submitModalCart = function() {
        const popup = document.querySelector('.swal2-popup');
        if (!popup) { Swal.close(); return; }
        const notes = String(popup.querySelector('#product-notes')?.value || '').trim();
        // Fallback: if not on PlaceShop page (no #shopId element), get shopId/shopName from currentEditItem
        const shopId = String(document.getElementById('shopId')?.innerText.trim() || currentEditItem?.shopId || '');
        const shopName = String(document.querySelector('.shop-header-info h1')?.innerText || currentEditItem?.shopName || '').trim();

        const baseId = currentCustomization.baseItemId || 'custom';
        const sizeId = (currentCustomization && currentCustomization.size) ? String(currentCustomization.size.id) : '';
        const uniqueId = baseId + (sizeId ? `-size-${sizeId}` : '');

        const isCustomProduct = !!(currentCustomization.isCustomProduct || (typeof currentTriggeringProduct === 'object' && currentTriggeringProduct?.closest('.foodItem')?.classList.contains('custom-item')) || currentEditItem?.isCustomProduct);

        // Build clean extras array — filter out any zero-qty or invalid entries
        const cleanExtras = (Array.isArray(currentCustomization.extras) ? currentCustomization.extras : []).filter(e => e && e.id && (e.qty || 1) >= 1).map(e => ({
            id: String(e.id),
            name: String(e.name || ''),
            price: Number(e.price) || 0,
            qty: Math.max(1, parseInt(e.qty) || 1)
        }));

        // Build clean upsells array — filter out any zero-qty or invalid entries
        const cleanUpsells = (Array.isArray(currentCustomization.upsells) ? currentCustomization.upsells : []).filter(u => u && u.id && (u.qty || 1) >= 1).map(u => ({
            id: String(u.id),
            name: String(u.name || ''),
            price: Number(u.price) || 0,
            qty: Math.max(1, parseInt(u.qty) || 1)
        }));

        // Build clean size object or null
        const cleanSize = currentCustomization.size ? {
            id: String(currentCustomization.size.id),
            name: String(currentCustomization.size.name || ''),
            price: Number(currentCustomization.size.price) || 0
        } : null;

        const hasActualCustomizations = !!(cleanSize || cleanExtras.length > 0 || cleanUpsells.length > 0 || notes);

        // Build the item from scratch — only carry over non-customization metadata from editItem
        const mainItem = {
            id: baseId,
            cartItemId: uniqueId,
            sizeId: sizeId,
            name: String(popup.querySelector('h1')?.innerText || currentEditItem?.name || 'Product').trim(),
            price: Number(basePrice) || 0,
            productBasePrice: Number(currentProductBasePrice) || 0,
            isCustomProduct: isCustomProduct,
            isCustomized: isCustomProduct || hasActualCustomizations,
            customization: {
                size: cleanSize,
                extras: cleanExtras,
                upsells: cleanUpsells,
                notes: notes
            },
            shopId: shopId,
            shopName: shopName,
            notes: notes,
            image: popup.querySelector('.modal-banner img')?.src || currentEditItem?.image || '',
            // Carry over delivery/area metadata from editItem if available (these are NOT customization data)
            placeId: currentEditItem?.placeId || '',
            areaId: currentEditItem?.areaId || '',
            shopAreaId: currentEditItem?.shopAreaId || '',
            addId: currentEditItem?.addId || '',
            deliveryFee: currentEditItem?.deliveryFee || 0,
            deliveryTime: currentEditItem?.deliveryTime || 0
        };

        let addedStatus = false;
        if (window.cart) {
            const editItemId = currentEditItem ? (currentEditItem.cartItemId || currentEditItem.id) : null;
            if (editItemId && String(editItemId) === String(uniqueId)) {
                // Update in place
                addedStatus = window.cart.addItem(mainItem, quantity, true);
            } else {
                // Remove and add (ID changed or new item)
                const targetShopId = mainItem.shopId || GLOBAL_shop_ID;
                const shopExists = window.cart.items.some(i => String(i.shopId) === String(targetShopId));
                const isSameShopEdit = currentEditItem && String(currentEditItem.shopId) === String(targetShopId);
                const isDifferentShop = !isSameShopEdit && !shopExists && window.cart.items.length > 0;

                if (!isDifferentShop && currentEditItem) {
                    window.cart.removeItem(editItemId, currentEditItem.shopId);
                }
                addedStatus = window.cart.addItem(mainItem, quantity, false);
            }
        }
        if (addedStatus === false) return;
        Swal.close();
        setTimeout(() => {
            Swal.fire({ icon: 'success', title: 'تمت الإضافة', timer: 1500, showConfirmButton: false, toast: true, position: 'top-end' });
            if (typeof syncProductBadges === 'function') syncProductBadges();
        }, 100);
    };

    window.addUpsellItem = function(btn, price, id, name) {
        const wrapper = btn.closest('.upsell-img-wrapper');
        btn.style.display = 'none';
        wrapper.querySelector('.qty-control').style.display = 'flex';
        const badge = wrapper.querySelector('.upsell-badge');
        if (badge) { badge.style.display = 'flex'; badge.innerText = '1'; }
        const strId = String(id);
        // Prevent duplicates and enforce clean schema
        if (!currentCustomization.upsells.some(x => String(x.id) === strId)) {
            currentCustomization.upsells = [...currentCustomization.upsells, { id: strId, name: String(name), price: Number(price) || 0, qty: 1 }];
        }
        recalculateAddonsPrice();
        updateModalTotal();
    };

    window.updateUpsellQty = function(btn, delta, price, id) {
        const valSpan = btn.closest('.qty-control').querySelector('.upsell-qty-val');
        let q = Math.max(0, parseInt(valSpan.innerText) + delta);
        valSpan.innerText = q;
        const strId = String(id);
        const upsell = currentCustomization.upsells.find(x => String(x.id) === strId);
        if (upsell) upsell.qty = q;
        if (q === 0) {
            currentCustomization.upsells = currentCustomization.upsells.filter(x => String(x.id) !== strId);
            const wrapper = btn.closest('.upsell-img-wrapper');
            wrapper.querySelector('.upsell-add-btn').style.display = 'flex';
            wrapper.querySelector('.upsell-badge').style.display = 'none';
            btn.closest('.qty-control').style.display = 'none';
            valSpan.innerText = 1;
        } else {
            const badge = btn.closest('.upsell-img-wrapper').querySelector('.upsell-badge');
            if (badge) { badge.innerText = q; badge.style.display = 'flex'; }
        }
        recalculateAddonsPrice();
        updateModalTotal();
    };

    window.openSimpleNotesModal = function(el, name, price, desc = '', idOverride = null) {
        openProductModal(idOverride || el?.getAttribute('id'), null, true);
    };

    window.openHardcodedModal = function(editItem, prodName, prodPrice, triggerEl, prodDesc, focusNotes) {
        openProductModal(triggerEl || editItem?.id, editItem, focusNotes);
    };
</script>
<figure id="sideCartOverlay" onclick="if(event.target === this) closeSideCart()">
    <aside id="sideCart">
        <div class="side-cart-header">
            <h1>
                <asp:Literal ID="ltSideCartTitle" runat="server" Text="<%$ Resources:texts, ShoppingCartTitle %>"></asp:Literal>
            </h1>
            <button type="button" class="close-side-cart" onclick="closeSideCart()">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>
        <div id="sideCartContent">
             <!-- Empty cart message -->
            <figure id="emptyCart">
                <i class="fa-solid fa-cart-shopping"></i>
                <p>
                    <asp:Literal ID="ltEmptyCartSide" runat="server"
                        Text="<%$ Resources:texts, EmptyCartMessage %>"></asp:Literal>
                </p>
            </figure>

            <!-- Cart items -->
            <figure id="inCartItems">
                <!-- items injected by Cart.js -->

                <div class="side-cart-footer-container">
                    <div class="preDeliveryFeeAmount">
                        <p>
                            <asp:Literal ID="ltSubtotalSide" runat="server"
                                Text="<%$ Resources:texts, Subtotal %>"></asp:Literal>
                        </p>
                        <span class="subtotalAmount">0.00 <%= Resources.Texts.Currency %></span>
                    </div>

                    <div class="deliveryAmount">
                        <p>
                            <asp:Literal ID="ltDeliveryFeeTextSide" runat="server"
                                Text="<%$ Resources:texts, DeliveryFee %>"></asp:Literal>
                            <i class="fa-solid fa-circle-info"></i>
                        </p>
                        <span class="deliveryFee">0.00 <%= Resources.Texts.Currency %></span>
                    </div>

                    <div class="afterDeliveryFeeAmount">
                        <p>
                            <asp:Literal ID="ltTotalAmountTextSide" runat="server"
                                Text="<%$ Resources:texts, TotalAmount %>"></asp:Literal>
                        </p>
                        <span class="totalAmount">0.00 <%= Resources.Texts.Currency %></span>
                    </div>

                    <div class="confirmCartActions">
                        <button class="submit" type="button">
                            <a href="checkout.aspx">
                                <asp:Literal ID="ltCheckoutSide" runat="server"
                                    Text="<%$ Resources:texts, Checkout %>"></asp:Literal>
                            </a>
                        </button>
                        <button type="button" id="emptyCartBtn"
                            title='<asp:Literal ID="ltEmptyCartTitleSide" runat="server" Text="<%$ Resources:texts, EmptyCart %>" />'
                            aria-label='<asp:Literal ID="ltEmptyCartAriaSide" runat="server" Text="<%$ Resources:texts, EmptyCart %>" />'>
                            <i class="fa-solid fa-trash"></i>
                        </button>
                    </div>
                </div>
            </figure>
        </div>
    </aside>
</figure>
</body>
</html>
