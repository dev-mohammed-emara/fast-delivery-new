    <style>
        /* زر العودة للأعلى - منضبط حسب منطق الرؤية */
        .back-to-top {
            position: fixed;
            bottom: 25px;
            display: none;
            background-color: #ffc107;
            color: #fff !important;
            width: 50px;
            height: 50px;
            border-radius: 50%;
            border: none;
            cursor: pointer;
            z-index: 100;
            box-shadow: 0 4px 15px rgba(0,0,0,0.3);
            transition: all 0.3s ease;
            font-size: 20px;
            line-height: 50px;
            text-align: center;
        }

        /* التحكم في الاتجاه بناءً على خاصية dir في الـ html */
        /* لو الصفحة عربي (RTL) خليه يمين */
        [dir="rtl"] .back-to-top {
            right: 25px;
            left: auto;
        }

        /* لو الصفحة إنجليزي (LTR) خليه شمال */
        [dir="ltr"] .back-to-top {
            left: 25px;
            right: auto;
        }

        .back-to-top:hover {
            background-color: #e0a800;
            transform: translateY(-5px);
        }

        :root {
            --safe-area-inset-top: env(safe-area-inset-top, 0px);
            --safe-area-inset-bottom: env(safe-area-inset-bottom, 0px);
            --safe-area-inset-left: env(safe-area-inset-left, 0px);
            --safe-area-inset-right: env(safe-area-inset-right, 0px);
        }

        body {
            padding-bottom: var(--safe-area-inset-bottom);
        }

        .header {
            padding-top: calc(8px + var(--safe-area-inset-top));
        }
        /* WhatsApp Floating Button */
.whatsapp-float {
    position: fixed;
    bottom: 90px; /* مرتفع قليلاً عن زر العودة للأعلى */
    width: 55px;
    height: 55px;
    background-color: #25d366;
    color: #FFF !important;
    border-radius: 50px;
    text-align: center;
    font-size: 30px;
    box-shadow: 2px 2px 10px rgba(0,0,0,0.2);
    z-index: 90;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
}

/* ضبط الاتجاه حسب اللغة */
[dir="rtl"] .whatsapp-float {
    right: 25px;
}

[dir="ltr"] .whatsapp-float {
    left: 25px;
}

.whatsapp-float:hover {
    transform: scale(1.1);
    background-color: #128c7e;
}

/* تأثير النبض الاختياري */
.whatsapp-float::before {
    content: "";
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: #25d366;
    border-radius: 50%;
    z-index: -1;
    animation: pulse-whatsapp 2s infinite;
}

@keyframes pulse-whatsapp {
    0% { transform: scale(1); opacity: 0.5; }
    100% { transform: scale(1.6); opacity: 0; }
}
    </style>
    <style>
        .mobile-nav-item.active,
        .mobile-nav-item.active i,
        .mobile-nav-item.active span {
            color: var(--fd-blue) !important;
