   <%-- <link href="css/css_web.css" rel="stylesheet" />--%>
   <script type="text/javascript">
       const btnUp = document.getElementById("backToTop");
       window.onscroll = function() {
           if (document.body.scrollTop > 300 || document.documentElement.scrollTop > 300) {
               btnUp.style.display = "block";
           } else {
               btnUp.style.display = "none";
           }
       };
       btnUp.onclick = function() {
           window.scrollTo({ top: 0, behavior: 'smooth' });
       };
        function setLang(lang) {
            var expireDate = new Date();
            expireDate.setFullYear(expireDate.getFullYear() + 1); // الكوكي لمدة سنة
            document.cookie = "lang=" + lang + "; expires=" + expireDate.toUTCString() + "; path=/";
            location.reload();
        }
    </script>

     <script>

function getCookie(name) {
    const value = `; ${document.cookie}`;
    const parts = value.split(`; ${name}=`);
    if (parts.length === 2) return parts.pop().split(';').shift();
    return null;
}

function loadTextsOnStart() {
    const lang = getCookie("lang") || "en";

    // امسح أي سكريبت موجود
    const old = document.getElementById("dynamic-texts");
    if (old) old.remove();

    const script = document.createElement("script");
    script.id = "dynamic-texts";
    script.charset = "utf-8";

    // منع الكاش عشان المتصفح مش يشغّل نسخة قديمة
    const rnd = Math.random();
    script.src = `js/texts_${lang}.js?v=${rnd}`;

    // تحميل إجباري
    script.async = false;
    script.defer = false;

    script.onload = function () {
        console.log("Loaded:", script.src);
        try {
            updateUIWithTexts();
        } catch (e) {
            console.warn("updateUIWithTexts missing");
        }
    };

    script.onerror = () => console.error("Error loading language file!");

    document.head.appendChild(script);
}

// تشغيل أول ما الصفحة تحمل
document.addEventListener("DOMContentLoaded", loadTextsOnStart);
</script>
    <script type="text/javascript">
    var isInternalRouting = document.referrer.indexOf(window.location.host) !== -1;
    var isReload = false;
    if (window.performance) {
        var navEntries = window.performance.getEntriesByType("navigation");
        if (navEntries.length > 0 && navEntries[0].type === "reload") {
            isReload = true;
        } else if (window.performance.navigation && window.performance.navigation.type === 1) {
            isReload = true;
        }
    }

    // Hide if it IS internal routing AND NOT a reload
    if (isInternalRouting && !isReload) {
        var wrapper = document.getElementById('loader-wrapper');
        if (wrapper) wrapper.style.display = 'none';
    } else {
        window.addEventListener('load', function() {
            var logo = document.getElementById('preloaderLogo');
            if (logo) logo.classList.add('shine');
            setTimeout(function() {
                var wrapper = document.getElementById('loader-wrapper');
                if (wrapper) wrapper.classList.add('preloader-exit');
                setTimeout(function() {
                    if (wrapper) wrapper.style.display = 'none';
                }, 600);
            }, 800);
        });
    }

    document.getElementById('searchIconNav').addEventListener('click', function() {
        const shopSearcher = document.getElementById('selectedShopSearcher');
        if (shopSearcher) {
            shopSearcher.focus();
            shopSearcher.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
    });
</script>
</body>
</html>
