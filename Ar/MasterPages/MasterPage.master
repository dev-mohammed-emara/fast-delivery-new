    <script>
        function handleProfileClick(event) {
            if (event) event.preventDefault();

            // Check if user is logged in via the body class
            const isLoggedOut = document.body.classList.contains('not-logged-in');

            if (isLoggedOut) {
                showModal();
            } else {
                // Determine if we should show desktop or mobile menu
                if (window.innerWidth <= 768) {
                    if (typeof toggleMobileProfileMenu === 'function') {
                        toggleMobileProfileMenu(event);
                    }
                } else {
                    if (typeof toggleProfileMenu === 'function') {
                        toggleProfileMenu(event);
                    }
                }
            }
        }
    </script>
      <link rel="stylesheet" href="css/main.css">
   <%-- <link href="css/css_web.css" rel="stylesheet" />--%>
   <script type="text/javascript">
       const btnUp = document.getElementById("backToTop");
       window.onscroll = function() {
           if (document.body.scrollTop > 300 || document.documentElement.scrollTop > 300) {
               btnUp.style.display = "block";
           } else {
               btnUp.style.display = "none";
           }
       };
        btnUp.onclick = function() {
            window.scrollTo({ top: 0, behavior: 'smooth' });
        };
         function setLang(lang) {
             var expireDate = new Date();
             expireDate.setFullYear(expireDate.getFullYear() + 1); // الكوكي لمدة سنة
             document.cookie = "lang=" + lang + "; expires=" + expireDate.toUTCString() + "; path=/";
             location.reload();
         }

         window.shareShopGlobal = function(e) {
             if (e) e.preventDefault();
             const texts = window.texts || {};
             const shopNameEl = document.getElementById('shopName') || document.querySelector('.availableShopName');
             const shopName = shopNameEl ? shopNameEl.innerText : 'Fast Delivery';
             const shopUrl = window.location.href;
             const template = texts.ShareMessage || "Order now from {0} via Fast Delivery! {1}";
             const text = template.replace('{0}', shopName).replace('{1}', shopUrl);

             if (navigator.share) {
                 navigator.share({
                     title: texts.ShareTitle || 'Fast Delivery',
                     text: text,
                     url: shopUrl,
                 }).catch(console.error);
             } else {
                 const modalHtml = `
                     <div class="share-modal" style="padding: 1rem; text-align: center;">
                         <h3 style="margin-bottom: 1.5rem;">${texts.ShareTitle || 'مشاركة المتجر'}</h3>
                         <div style="display: flex; justify-content: center; gap: 1.5rem; font-size: 2rem;">
                             <a href="https://wa.me/?text=${encodeURIComponent(text)}" target="_blank" style="color: #25D366;"><i class="fa-brands fa-whatsapp"></i></a>
                             <a href="https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(shopUrl)}" target="_blank" style="color: #1877F2;"><i class="fa-brands fa-facebook"></i></a>
                             <a href="https://twitter.com/intent/tweet?text=${encodeURIComponent(text)}" target="_blank" style="color: #1DA1F2;"><i class="fa-brands fa-twitter"></i></a>
                         </div>
                         <div style="margin-top: 1.5rem;">
                             <input type="text" value="${shopUrl}" id="shareUrlInputGlobal" readonly style="width: 100%; padding: 10px; border: 1px solid #eee; border-radius: 10px; text-align: center; margin-bottom: 10px;">
                             <button onclick="copyToClipboardGlobal('${shopUrl}')" style="background: #ffc107; color: white; border: none; padding: 10px 20px; border-radius: 10px; cursor: pointer; width: 100%; font-weight: 700;">Copy Link</button>
                         </div>
                     </div>
                 `;
                 Swal.fire({
                     html: modalHtml,
                     showConfirmButton: false,
                     width: '320px',
                     padding: '10px'
                 });
             }
         };

         window.copyToClipboardGlobal = function(url) {
             navigator.clipboard.writeText(url).then(() => {
                 Swal.fire({ icon: 'success', title: 'Copied!', timer: 1500, showConfirmButton: false });
             });
         };
    </script>

     <script>

function getCookie(name) {
    const value = `; ${document.cookie}`;
    const parts = value.split(`; ${name}=`);
    if (parts.length === 2) return parts.pop().split(';').shift();
    return null;
}

function loadTextsOnStart() {
    const lang = getCookie("lang") || "en";

    // امسح أي سكريبت موجود
    const old = document.getElementById("dynamic-texts");
    if (old) old.remove();

    const script = document.createElement("script");
    script.id = "dynamic-texts";
    script.charset = "utf-8";

    // منع الكاش عشان المتصفح مش يشغّل نسخة قديمة
    const rnd = Math.random();
    script.src = `js/texts_${lang}.js?v=${rnd}`;

    // تحميل إجباري
    script.async = false;
    script.defer = false;

    script.onload = function () {
        console.log("Loaded:", script.src);
        try {
            updateUIWithTexts();
        } catch (e) {
            console.warn("updateUIWithTexts missing");
        }
    };

    script.onerror = () => console.error("Error loading language file!");

    document.head.appendChild(script);
}

// تشغيل أول ما الصفحة تحمل
document.addEventListener("DOMContentLoaded", loadTextsOnStart);
</script>
    <script type="text/javascript">
    var isInternalRouting = document.referrer.indexOf(window.location.host) !== -1;
    var isReload = false;


    document.getElementById('searchIconNav').addEventListener('click', function() {
        const shopSearcher = document.getElementById('selectedShopSearcher');
        if (shopSearcher) {
            shopSearcher.focus();
            shopSearcher.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
    });

    window.openSideCart = function() {
        const overlay = document.getElementById('sideCartOverlay');
        if (overlay) {
            overlay.classList.add('openSideCart');
            document.body.style.overflow = 'hidden';
            if (typeof updateCartUI === 'function') {
                updateCartUI();
            }
        }
    };

    window.closeSideCart = function() {
        const overlay = document.getElementById('sideCartOverlay');
        if (overlay) {
            overlay.classList.remove('openSideCart');
            document.body.style.overflow = '';
        }
    };

    // Close side cart on back navigation
    window.addEventListener('popstate', function() {
        closeSideCart();
    });
</script>
<figure id="sideCartOverlay" onclick="if(event.target === this) closeSideCart()">
    <aside id="sideCart">
        <div class="side-cart-header">
            <h1>
                <asp:Literal ID="ltSideCartTitle" runat="server" Text="<%$ Resources:texts, ShoppingCartTitle %>"></asp:Literal>
            </h1>
            <button type="button" class="close-side-cart" onclick="closeSideCart()">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>
        <div id="sideCartContent">
             <!-- Empty cart message -->
            <figure id="emptyCart">
                <i class="fa-solid fa-cart-shopping"></i>
                <p>
                    <asp:Literal ID="ltEmptyCartSide" runat="server"
                        Text="<%$ Resources:texts, EmptyCartMessage %>"></asp:Literal>
                </p>
            </figure>

            <!-- Cart items -->
            <figure id="inCartItems">
                <!-- items injected by Cart.js -->

                <div class="side-cart-footer-container">
                    <div class="preDeliveryFeeAmount">
                        <p>
                            <asp:Literal ID="ltSubtotalSide" runat="server"
                                Text="<%$ Resources:texts, Subtotal %>"></asp:Literal>
                        </p>
                        <span class="subtotalAmount">0.00 <%= Resources.Texts.Currency %></span>
                    </div>

                    <div class="deliveryAmount">
                        <p>
                            <asp:Literal ID="ltDeliveryFeeTextSide" runat="server"
                                Text="<%$ Resources:texts, DeliveryFee %>"></asp:Literal>
                            <i class="fa-solid fa-circle-info"></i>
                        </p>
                        <span class="deliveryFee">0.00 <%= Resources.Texts.Currency %></span>
                    </div>

                    <div class="afterDeliveryFeeAmount">
                        <p>
                            <asp:Literal ID="ltTotalAmountTextSide" runat="server"
                                Text="<%$ Resources:texts, TotalAmount %>"></asp:Literal>
                        </p>
                        <span class="totalAmount">0.00 <%= Resources.Texts.Currency %></span>
                    </div>

                    <div class="confirmCartActions">
                        <button class="submit" type="button">
                            <a href="checkout.aspx">
                                <asp:Literal ID="ltCheckoutSide" runat="server"
                                    Text="<%$ Resources:texts, Checkout %>"></asp:Literal>
                            </a>
                        </button>
                        <button type="button" id="emptyCartBtn"
                            title='<asp:Literal ID="ltEmptyCartTitleSide" runat="server" Text="<%$ Resources:texts, EmptyCart %>" />'
                            aria-label='<asp:Literal ID="ltEmptyCartAriaSide" runat="server" Text="<%$ Resources:texts, EmptyCart %>" />'>
                            <i class="fa-solid fa-trash"></i>
                        </button>
                    </div>
                </div>
            </figure>
        </div>
    </aside>
</figure>
</body>
</html>
