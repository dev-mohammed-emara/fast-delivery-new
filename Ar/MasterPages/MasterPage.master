    <%--<script src="js/shops.js"></script>--%>
   <%-- <script src="js/selectedLocation.js"></script>--%>
      <link rel="stylesheet" href="css/main.css"> 
   <%-- <link href="css/css_web.css" rel="stylesheet" />--%>
   <script type="text/javascript">
        function setLang(lang) {
            var expireDate = new Date();
            expireDate.setFullYear(expireDate.getFullYear() + 1); // الكوكي لمدة سنة
            document.cookie = "lang=" + lang + "; expires=" + expireDate.toUTCString() + "; path=/";
            location.reload();
        }
    </script>
     
     <script>

function getCookie(name) {
    const value = `; ${document.cookie}`;
    const parts = value.split(`; ${name}=`);
    if (parts.length === 2) return parts.pop().split(';').shift();
    return null;
}

function loadTextsOnStart() {
    const lang = getCookie("lang") || "en";

    // امسح أي سكريبت موجود
    const old = document.getElementById("dynamic-texts");
    if (old) old.remove();

    const script = document.createElement("script");
    script.id = "dynamic-texts";

    // منع الكاش عشان المتصفح مش يشغّل نسخة قديمة
    const rnd = Math.random();
    script.src = `js/texts_${lang}.js?v=${rnd}`;

    // تحميل إجباري
    script.async = false;
    script.defer = false;

    script.onload = function () {
        console.log("Loaded:", script.src);
        try {
            updateUIWithTexts();
        } catch (e) {
            console.warn("updateUIWithTexts missing");
        }
    };

    script.onerror = () => console.error("Error loading language file!");

    document.head.appendChild(script);
}

// تشغيل أول ما الصفحة تحمل
document.addEventListener("DOMContentLoaded", loadTextsOnStart);
</script>

</body>
</html>
